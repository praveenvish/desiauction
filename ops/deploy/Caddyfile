# CADDY'S OWN LOG, FILTERED THE SAME WAY AS THE WEBHOOK ACCESS LOG BELOW.
#
# Caddy writes an `http.log.error` line for every failed upstream request —
# a 502 while web restarts, say — and that line carries the FULL request:
# every header and the query string. Measured before this block existed: a
# webhook arriving during a restart put its `X-Razorpay-Signature` into the
# container log verbatim, and Alloy ships container logs to Loki for thirty
# days. The default logger is filtered here so no Caddy line, access or error,
# can carry a header, a client address or a query string.
{
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>uri regexp "\?.*$" "?[redacted]"
			}
		}
	}
}

# TLS is automatic: Caddy provisions and renews Let's Encrypt certificates and
# redirects http→https. Nothing here needs a cron job or a renewal reminder.
{$PUBLIC_DOMAIN} {
	encode zstd gzip
	# No legitimate request to the web tier is large: server actions stop at
	# Next's 1 MB, photos go straight to object storage on a presigned URL, and
	# webhooks are a few KB. Without a ceiling, a chunked POST to an
	# unauthenticated route streams until the container runs out of memory.
	request_body {
		max_size 10MB
	}

	# AN ACCESS LOG FOR THE WEBHOOK ROUTES, AND ONLY THOSE (ALERTS.md 5).
	#
	# Those routes fail closed and quietly by design — an unconfigured secret
	# 404s, an unverifiable payload is refused — and they log nothing of their
	# own, so a rotated provider secret was invisible until money stopped
	# arriving. This line is the signal the webhook alerts count.
	#
	# Everything else is skipped on purpose: a log of every page view is a log
	# of every visitor's IP and every token-bearing URL, kept for thirty days,
	# for no alert anybody asked for. And from what IS logged, the parts that
	# identify a person or carry a credential are removed before the line is
	# written: headers (the provider signatures and callback secrets ride
	# there), the client addresses, and the query string.
	@not_webhook not path /api/webhooks/*
	log_skip @not_webhook
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>uri regexp "\?.*$" "?[redacted]"
				resp_headers delete
			}
		}
	}

	reverse_proxy web:3000
}

# The engine on its own hostname, because ENGINE_ALLOWED_ORIGINS and the
# browser's WebSocket origin check both key on it. wss:// is what the browser
# gets, which is why this must be a real certificate and not a self-signed one.
{$ENGINE_DOMAIN} {
	encode zstd gzip
	reverse_proxy engine:4000
}

# Object storage, on its own hostname (Hetzner-only topology).
#
# PUBLIC ON PURPOSE, and only as far as it has to be. Two different clients
# need to reach this host and neither is server-side:
#
#   THE BROWSER UPLOADING A PHOTO. `presignUpload` signs a PUT against
#   MEDIA_S3_ENDPOINT and hands that URL to the browser, and an AWS v4
#   signature covers the Host header — so the endpoint the app signs for has to
#   be the hostname the browser will actually call. Pointing it at the internal
#   `minio:9000` produces URLs that are valid and unreachable.
#
#   THE BROWSER READING A PHOTO. The signer builds path-style URLs
#   (`/<bucket>/<key>`), so MEDIA_PUBLIC_BASE is this origin plus the media
#   bucket, and no rewrite is needed here.
#
# What stops this from being an open door is the bucket policy set by
# `minio-init`, not this file: anonymous download on the media bucket, nothing
# at all on the finops bucket. Writes need a signature in every case. That is
# the same posture a public R2 bucket has.
{$S3_DOMAIN} {
	encode zstd gzip
	# Photos and registers are already-compressed blobs and can be large; the
	# default 100MB body limit is a browser-side upload failure waiting to
	# happen, and the app's own allow-list is what actually bounds a file.
	request_body {
		max_size 25MB
	}
	reverse_proxy minio:9000
}
