{
  "extends": "@desiauction/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "incremental": true,
    "allowJs": false,
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [".next/types/**/*.ts", "next-env.d.ts", "scripts", "src", ".next-e2e/types/**/*.ts"],
  "exclude": ["node_modules"]
}
