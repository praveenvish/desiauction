{
  "extends": "@desiauction/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "incremental": true,
    "allowJs": false,
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    ".next/types/**/*.ts",
    "next-globals.d.ts",
    "scripts",
    "src",
    ".next-e2e/types/**/*.ts",
    "src/app/.well-known/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
