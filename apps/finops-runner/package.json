{
  "name": "@desiauction/finops-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.mjs --external:postgres --external:drizzle-orm --external:ulidx --external:zod --external:pino --external:pino-pretty --external:@sentry/node",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "env:check": "node --env-file-if-exists=../../.env.local node_modules/tsx/dist/cli.mjs scripts/check-env.ts"
  },
  "dependencies": {
    "@desiauction/core": "workspace:*",
    "@desiauction/db": "workspace:*",
    "@desiauction/financial-operations": "workspace:*",
    "@sentry/node": "^10.15.0",
    "drizzle-orm": "^0.45.2",
    "pino": "^9.9.0",
    "postgres": "^3.4.0",
    "ulidx": "^2.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@desiauction/config": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "pino-pretty": "^13.1.0"
  }
}
