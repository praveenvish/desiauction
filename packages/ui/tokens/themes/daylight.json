  },
  "live": { "$value": "{color.green.light}", "$type": "color" },
  "//strong": "The `strong` ramp is the text colour on its own `subtle` bed (badges), not on bare surface. Each value clears 4.5:1 against subtle-over-{surface, raised, sunken} — the composite is darker than the surface, so tuning against `surface` alone lands ~4.25 and fails axe.",
  "success": {
    "subtle": { "$value": "#1D9E5F1A", "$type": "color" },
