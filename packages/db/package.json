{
  "name": "@desiauction/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/check-snapshots.mjs && node --env-file-if-exists=../../.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=../../.env.local scripts/migrate.mjs",
    "db:check-snapshots": "node scripts/check-snapshots.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.0",
    "ulidx": "^2.4.0"
  },
  "devDependencies": {
    "@desiauction/config": "workspace:*",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.0"
  }
}
