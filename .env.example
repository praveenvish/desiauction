# Copy to .env.local for local development; never put a real secret here.
# Every variable is validated fail-closed by each app's env.ts (IP-0_DESIGN §11).

# --- engine ---
# Local docker-compose Postgres (matches docker-compose.yml; non-secret by design)
DATABASE_URL=postgres://desiauction:desiauction@localhost:5433/desiauction
# Sockets per pool, per process (web only). Unset = 10. The web tier opens two
# pools, so a deployed fleet spends 2 x DB_POOL_MAX x instances against the
# database's max_connections — size it there, not in code.
# DB_POOL_MAX=10
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Engine HTTP/WS port
PORT=4000
# Error tracking; leave unset locally (Sentry is a deployed-env concern)
# SENTRY_DSN=

# --- both apps ---
# NODE_ENV deliberately absent: the runtime owns it (next dev → development,
# next build/start → production). Forcing development into a production build
# corrupts prerendering (M-IP2-4 finding); env.ts defaults cover bare node.
# Git SHA in deployed environments; "dev" locally
APP_VERSION=dev

# --- web: player/team media (parity §3.1) ---
# "local" (default) writes uploads under apps/web/public/_media — DEV/e2e ONLY
# (a built server does not serve runtime-written public files, and it is an
# authenticated-write path surface). Production MUST set "bucket" (enforced by
# scripts/preflight-production.mjs) and point MEDIA_PUBLIC_BASE at the CDN/bucket.
MEDIA_STORAGE=local
# MEDIA_PUBLIC_BASE=https://cdn.example.com

# --- engine: WebSocket exposure (audit 2026-08-18, P0-3) ---
# Browser origins allowed to open a spectate socket, comma-separated. A ticket
# authorises an AUCTION, not a PAGE, so unset means "do not check" — right for
# local dev and native clients. REQUIRED in production: the engine refuses to
# boot without it and `preflight:production` fails on it (https origins only).
# ENGINE_ALLOWED_ORIGINS=https://desiauction.in,https://www.desiauction.in
# DoS ceilings; defaults shown.
# WS_MAX_SOCKETS_PER_ROOM=2000
# WS_MAX_SOCKETS_PER_IP=50
# Per-actor command rate limit (token bucket). Sized well above human play —
# raise only with evidence from a real auction night.
# ENGINE_RATE_BURST=200
# ENGINE_RATE_REFILL_PER_SEC=50

# --- web: payments (audit 2026-08-18, P1-5) ---
# All three together or the gateway is simply absent and payments stay on the
# manual adapters. RAZORPAY_WEBHOOK_SECRET is what makes /api/webhooks/razorpay
# exist at all: unset means the route 404s rather than accepting callbacks it
# cannot verify.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- web: transactional email (Resend on mail.desiauction.in) ---
# All three of ENDPOINT/KEY/FROM together or the mailer reports "unconfigured"
# and drops nothing silently — a half-configured provider is worse than an
# absent one. Sending is on a SUBDOMAIN so registration-mail bounces cannot
# touch the reputation the grievance and privacy mailboxes depend on; the root
# zone stays Zoho-only. The default request body is already Resend's shape, so
# another provider is a change of ENDPOINT plus a `buildRequest` override.
# EMAIL_API_ENDPOINT=https://api.resend.com/emails
# EMAIL_API_KEY=
# EMAIL_FROM=DesiAuction <no-reply@mail.desiauction.in>
# Where a human reply lands. Deliberately NOT part of the three-way check
# above: without it, someone replying to a receipt is talking to a wall, but
# the provider is still perfectly configured.
# EMAIL_REPLY_TO=support@desiauction.in

# --- web: tenant isolation (the four-role recipe) ---
# The RLS-exempt SYSTEM pool must be a DIFFERENT role from the app pool in
# production; unset aliases the app pool (local only). The app pool's role must
# be NOBYPASSRLS — apps/web asserts this at boot (PRR P1-1). See
# ops/db/create-app-role.sql.
# SYSTEM_DATABASE_URL=postgres://desiauction_system:...@host:5432/desiauction
# How many trusted reverse proxies sit in front (per-IP throttles read the
# forwarded-for hop THEY appended, never the spoofable client one). 0 = local;
# behind a single Vercel/Fly ingress, set 1 (PRR P2/F32).
# TRUSTED_PROXY_COUNT=1

# --- web ↔ engine trust (M-IP4-2) ---
# The shared secret authenticating every conduct command; the dev default is
# refused when serving. ENGINE_URL is the deployed engine (web → HTTP);
# ENGINE_PUBLIC_WS_URL is the wss:// URL browsers open.
# ENGINE_SECRET=<32+ random chars>
# ENGINE_URL=https://desiauction-engine.example.com
# ENGINE_PUBLIC_WS_URL=wss://desiauction-engine.example.com/ws

# --- web: login (OTP-first) ---
# "dev" writes codes to a table (local only); production MUST be "msg91" with
# credentials or login is impossible.
OTP_PROVIDER=dev
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# Inbound STOP webhook + delivery-report webhook shared secrets; unset closes
# each endpoint with a 404 (fail-closed).
# SMS_INBOUND_SECRET=<16+ random chars>
# DELIVERY_CALLBACK_SECRET=<16+ random chars>

# --- web: passkeys (WebAuthn) ---
# RP_ID must suffix-match the browser host; RP_ORIGINS are the https origins.
# RP_ID=desiauction.in
# RP_ORIGINS=https://desiauction.in,https://www.desiauction.in

# --- web: public origin (SEO / canonical / OG / sitemap) ---
# PUBLIC_BASE_URL=https://desiauction.in

# --- web + finops-runner: finops artifact storage (PRR P1-4) ---
# "filesystem" (default) writes to FINOPS_STORAGE_DIR — correct locally, but it
# cannot be shared between web and the runner on separate hosts. Production MUST
# use "bucket" (an S3/MinIO/R2 store both tiers read), enforced by
# preflight:production. Web and the runner must agree on all of these.
# FINOPS_STORAGE_DIR=/var/lib/desiauction/finops   # absolute, when filesystem
# FINOPS_ARTIFACT_STORE=bucket
# FINOPS_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# FINOPS_S3_REGION=ap-south-1
# FINOPS_S3_BUCKET=desiauction-finops
# FINOPS_S3_ACCESS_KEY_ID=
# FINOPS_S3_SECRET_ACCESS_KEY=

# --- web: scheduled jobs (endpoints a host cron calls; fail-closed 404) ---
# The settlement catch-up sweep repairs a lost journal effect (PRR P1-3):
# schedule POST /api/jobs/settlement-coordination with this header secret.
# SETTLEMENT_JOB_SECRET=<16+ random chars>
# Demo reminder + retention sweep: POST /api/jobs/demo-reminders.
# DEMO_JOB_SECRET=<16+ random chars>
# Key demo booking links are HMAC-derived from; dev default refused when serving.
# DEMO_TOKEN_SECRET=<32+ random chars>
